generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  male
  female
}

enum PreferredGender {
  male
  female
  both
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  BANNED
  DELETED
}

enum InteractionType {
  LIKE
  PASS
  MATCH
  BLOCK
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  dateOfBirth   DateTime
  gender        Gender
  height        Int?
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  photos        Photo[]
  preferences   Preference?
  likes         Like[]    @relation("Liker")
  likedBy       Like[]    @relation("Likee")
  passes        Pass[]    @relation("Passer")
  passedBy      Pass[]    @relation("Passe")
  matchesAsUser1 Match[]  @relation("User1Matches")
  matchesAsUser2 Match[]  @relation("User2Matches")
  blocks        Block[]   @relation("Blocker")
  blockedBy     Block[]   @relation("Blocked")
  reports       Report[]  @relation("Reporter")
  reportedIn    Report[]  @relation("Reported")
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([status])
}

model Profile {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Photo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  r2Key     String
  width     Int
  height    Int
  size      Int
  mimeType  String
  isPrimary Boolean  @default(false)
  orderIndex Int     @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isPrimary])
  @@index([userId, orderIndex])
}

model Preference {
  id                 String  @id @default(uuid())
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredGender    PreferredGender @default(both)
  minAge             Int     @default(18)
  maxAge             Int     @default(99)
  maxDistance        Int     @default(50)
  minHeight          Int?
  maxHeight          Int?
  physicalPreferences Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model Like {
  id        String @id @default(uuid())
  fromUserId String
  fromUser  User   @relation("Liker", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User   @relation("Likee", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([createdAt])
}

model Pass {
  id        String @id @default(uuid())
  fromUserId String
  fromUser  User   @relation("Passer", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User   @relation("Passe", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([createdAt])
}

model Match {
  id         String  @id @default(uuid())
  user1Id    String
  user1      User    @relation("User1Matches", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id    String
  user2      User    @relation("User2Matches", fields: [user2Id], references: [id], onDelete: Cascade)
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages   Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id, isActive])
  @@index([user2Id, isActive])
  @@index([createdAt])
}

model Message {
  id        String   @id @default(uuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  content   String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([matchId, createdAt])
  @@index([senderId])
}

model Block {
  id        String @id @default(uuid())
  blockerId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  reporter    User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId  String
  reported    User     @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reason      String
  description String?
  createdAt   DateTime @default(now())

  @@index([reporterId])
  @@index([reportedId])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}