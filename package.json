{
  "name": "vybe",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @vybe/api dev",
    "build:api": "pnpm --filter @vybe/api build",
    "start:api": "pnpm --filter @vybe/api start",
    "lint": "pnpm --filter @vybe/api lint && pnpm --filter @vybe/shared lint && pnpm --filter @vybe/database lint",
    "format": "pnpm -r exec prettier --write .",
    "db:generate": "pnpm --filter @vybe/database prisma generate",
    "db:push": "pnpm --filter @vybe/database prisma db push",
    "db:migrate": "pnpm --filter @vybe/database prisma migrate dev",
    "db:studio": "pnpm --filter @vybe/database prisma studio",
    "test": "pnpm -r exec vitest run",
    "test:watch": "pnpm -r exec vitest"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@8.10.0"
}